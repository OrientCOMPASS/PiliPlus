+/* PiliPlus VR extension: internal projection value for 180° equirectangular
+ * sources (not exposed through the public video_projection_mode_t enum). */
+#define PROJECTION_MODE_PILI_EQUIRECT_180 (PROJECTION_MODE_CUBEMAP_LAYOUT_STANDARD + 1)
+
+#define PILI_VR_PROJ_AUTO  0
+#define PILI_VR_PROJ_FLAT  1
+#define PILI_VR_PROJ_360   2
+#define PILI_VR_PROJ_180   3
+
+#define PILI_VR_STEREO_AUTO 0
+#define PILI_VR_STEREO_MONO 1
+#define PILI_VR_STEREO_SBS  2
+#define PILI_VR_STEREO_TB   3
+
+/* Effective projection mode after applying the VR override */
+static inline video_projection_mode_t
+EffectiveProjection(const vout_display_opengl_t *vgl)
+{
+    switch (vgl->vr_projection) {
+    case PILI_VR_PROJ_FLAT:
+        return PROJECTION_MODE_RECTANGULAR;
+    case PILI_VR_PROJ_360:
+        return PROJECTION_MODE_EQUIRECTANGULAR;
+    case PILI_VR_PROJ_180:
+        return PROJECTION_MODE_PILI_EQUIRECT_180;
+    default:
+        return vgl->fmt.projection_mode;
+    }
+}
+
+/* Effective multiview mode after applying the VR override */
+static inline video_multiview_mode_t
+EffectiveMultiview(const vout_display_opengl_t *vgl)
+{
+    switch (vgl->vr_stereo) {
+    case PILI_VR_STEREO_MONO:
+        return MULTIVIEW_2D;
+    case PILI_VR_STEREO_SBS:
+        return MULTIVIEW_STEREO_SBS;
+    case PILI_VR_STEREO_TB:
+        return MULTIVIEW_STEREO_TB;
+    default:
+        return vgl->fmt.multiview_mode;
+    }
+}
