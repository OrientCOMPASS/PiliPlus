+// VR / panoramic source metadata (PiliPlus). Set by the lavf demuxer from the
+// stream's spherical / stereo3d side data, exposed to clients as the
+// read-only `vr-metadata-projection` / `vr-metadata-layout` properties so the
+// app can resolve its "auto (by source metadata)" VR mode. Deliberately
+// separate from mp_codec_params.stereo_mode, which feeds mpv's own 3D OSD
+// machinery.
+enum {
+    MP_VR_PROJ_NONE = 0,    // no panoramic metadata (or plain 2D/rectilinear)
+    MP_VR_PROJ_360,         // equirectangular, full 360° horizontal coverage
+    MP_VR_PROJ_180,         // equirectangular, ~180° horizontal coverage
+    MP_VR_PROJ_CUBEMAP,     // cubemap layout (not supported by the VR renderer)
+    MP_VR_PROJ_OTHER,       // known but unsupported (fisheye, immersive, odd
+                            // tiles, unusual stereo arrangements, ...)
+};
+
+enum {
+    MP_VR_LAYOUT_NONE = 0,  // no stereo metadata (assume single view)
+    MP_VR_LAYOUT_MONO,      // explicitly declared flat/2D
+    MP_VR_LAYOUT_SBS,       // side by side (left/right)
+    MP_VR_LAYOUT_TB,        // top bottom (over/under)
+    MP_VR_LAYOUT_OTHER,     // checkerboard/interleaved/... (not supported)
+};
