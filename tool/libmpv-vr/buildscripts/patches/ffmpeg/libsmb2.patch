diff --git a/libavformat/libsmb2.c b/libavformat/libsmb2.c
new file mode 100644
index 0000000..e9a4b96
--- /dev/null
+++ b/libavformat/libsmb2.c
@@ -0,0 +1,383 @@
+/*
+ * SMB2/SMB3 protocol via libsmb2
+ * Copyright (c) 2026 PiliPlus contributors
+ *
