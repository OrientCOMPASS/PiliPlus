+        if ((sd = mp_av_stream_get_side_data(st, AV_PKT_DATA_SPHERICAL))) {
+            const AVSphericalMapping *sph = (const AVSphericalMapping *)sd;
+            sh->codec->vr_projection = mp_vr_projection_from_spherical(sph);
+            MP_VERBOSE(demuxer, "Found spherical metadata: %s (vr projection "
+                       "%d)\n", av_spherical_projection_name(sph->projection),
+                       sh->codec->vr_projection);
+        }
+        if ((sd = mp_av_stream_get_side_data(st, AV_PKT_DATA_STEREO3D))) {
+            sh->codec->vr_layout =
+                mp_vr_layout_from_stereo3d((const AVStereo3D *)sd);
+        }
+
