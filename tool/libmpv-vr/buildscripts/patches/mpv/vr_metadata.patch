+// VR / panoramic source metadata (PiliPlus): map the lavf spherical side data
+// onto the horizontal coverage the VR renderer (vo=gpu vr.c) understands.
+// The renderer supports full and half equirectangular maps only; everything
+// else is reported so the client can say "unsupported" instead of failing
+// silently.
+static int mp_vr_projection_from_spherical(const AVSphericalMapping *sph)
+{
+    switch (sph->projection) {
+    case AV_SPHERICAL_EQUIRECTANGULAR:
+        return MP_VR_PROJ_360;
+    case AV_SPHERICAL_HALF_EQUIRECTANGULAR:
+        return MP_VR_PROJ_180;
+    case AV_SPHERICAL_EQUIRECTANGULAR_TILE: {
+        // bound_* are 0.32 fixed point fractions of the FULL map (see
+        // av_spherical_tile_bounds): the frame covers the middle part, so
+        // coverage = 360° * (1 - (left + right) / UINT32_MAX). Quantize to
+        // the two coverages the renderer can build meshes for.
+        double frac = 1.0 - ((double)sph->bound_left +
+                             (double)sph->bound_right) / UINT32_MAX;
+        double cov = 360.0 * frac;
+        if (cov >= 300.0)
+            return MP_VR_PROJ_360;
+        if (cov >= 150.0)
+            return MP_VR_PROJ_180;
+        return MP_VR_PROJ_OTHER;
+    }
+    case AV_SPHERICAL_CUBEMAP:
+        return MP_VR_PROJ_CUBEMAP;
+    case AV_SPHERICAL_RECTILINEAR:
+        // Explicitly flat - treat like "no panoramic metadata".
+        return MP_VR_PROJ_NONE;
+    default:
+        // Fisheye / parametric immersive / future types.
+        return MP_VR_PROJ_OTHER;
+    }
+}
+
+static int mp_vr_layout_from_stereo3d(const AVStereo3D *s3d)
+{
+    switch (s3d->type) {
+    case AV_STEREO3D_2D:
+        return MP_VR_LAYOUT_MONO;
+    case AV_STEREO3D_SIDEBYSIDE:
+        return MP_VR_LAYOUT_SBS;
+    case AV_STEREO3D_TOPBOTTOM:
+        return MP_VR_LAYOUT_TB;
+    default:
+        // Checkerboard, lines/columns, frame sequencing, quincunx, ...
+        return MP_VR_LAYOUT_OTHER;
+    }
+}
