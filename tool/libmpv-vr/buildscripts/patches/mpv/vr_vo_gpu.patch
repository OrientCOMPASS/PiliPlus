+// Parse the packed "yaw=..,pitch=..,fov=.." view string (option vr-view)
+// over the scalar view fields, so a client can update all continuous view
+// parameters with a single property set (see video.h). Values are clamped to
+// the same ranges as the scalar options; the coverage/pole bounds are
+// applied per frame in vr_manual_angles() as usual.
+static void vr_parse_view_string(struct gl_video_opts *opts)
+{
+    if (!opts->vr_view || !opts->vr_view[0])
+        return;
+    float y, p, f;
+    if (sscanf(opts->vr_view, "yaw=%f,pitch=%f,fov=%f", &y, &p, &f) != 3)
+        return;
+    opts->vr_yaw = MPMIN(MPMAX(y, -360.0f), 360.0f);
+    opts->vr_pitch = MPMIN(MPMAX(p, -90.0f), 90.0f);
+    opts->vr_fov = MPMIN(MPMAX(f, 10.0f), 150.0f);
+}
+
+// Returns true if the only differences between the two option sets are the
+// "hot" VR *view* fields (layout/projection/eye/stereo-output/fov/yaw/pitch/
+// head-tracking/reset-view). Those are consumed per-frame by vr.c (mesh
+// rebuilds / tracker start-stop included), so a change confined to them must
+// NOT go through reinit_from_options(): head tracking and drag-look update
+// yaw/pitch many times per second, and tearing down the render chain for
+// each update is both slow and visible (this was the fatal flaw of the old
+// user-shader approach, see PiliPlus docs/piliplayer.md §9.1).
+//
+// The VR master flag (`vr`) is deliberately NOT hot: toggling it changes
+// dumb-mode eligibility (see VR_DUMB_FIX in check_dumb_mode), so it must go
+// through a full reinit to (un)enter dumb mode and to restore/whitelist
+// p->opts accordingly.
+static bool only_vr_view_opts_changed(const struct gl_video_opts *a,
+                                      const struct gl_video_opts *b)
+{
+    if (a->vr != b->vr)
+        return false;
+    struct gl_video_opts x = *a, y = *b;
+    x.vr_view = y.vr_view; // pointer owned by the cache; content is re-parsed
+    x.vr_layout = y.vr_layout;
+    x.vr_projection = y.vr_projection;
+    x.vr_eye = y.vr_eye;
+    x.vr_stereo_output = y.vr_stereo_output;
+    x.vr_fov = y.vr_fov;
+    x.vr_yaw = y.vr_yaw;
+    x.vr_pitch = y.vr_pitch;
+    x.vr_head_tracking = y.vr_head_tracking;
+    x.vr_reset_view = y.vr_reset_view;
+    // Padding bytes could theoretically differ and force the slow path; that
+    // is harmless (identical to today's behavior).
+    return memcmp(&x, &y, sizeof(x)) == 0;
+}
+
+// Copy just the VR fields of the option struct (hot update). Assigning the
+// whole struct instead would undo the adjustments check_gl_features() made to
+// p->opts (dumb-mode whitelist, compute-peak fallback, ...).
+static void copy_vr_opts(struct gl_video_opts *dst,
+                         const struct gl_video_opts *src)
+{
+    dst->vr = src->vr;
+    dst->vr_view = src->vr_view;
+    dst->vr_layout = src->vr_layout;
+    dst->vr_projection = src->vr_projection;
+    dst->vr_eye = src->vr_eye;
+    dst->vr_stereo_output = src->vr_stereo_output;
+    dst->vr_fov = src->vr_fov;
+    dst->vr_yaw = src->vr_yaw;
+    dst->vr_pitch = src->vr_pitch;
+    dst->vr_head_tracking = src->vr_head_tracking;
+    dst->vr_reset_view = src->vr_reset_view;
+}
