+int libvlc_media_player_set_vr_mode( libvlc_media_player_t *p_mi,
+                                     int i_projection, int i_stereo,
+                                     int i_eye )
+{
+    input_thread_t *p_input_thread = libvlc_get_input_thread( p_mi );
+    if( p_input_thread != NULL )
+    {
+        int i_ret = input_SetVrMode( p_input_thread, i_projection, i_stereo,
+                                     i_eye );
+        vlc_object_release( p_input_thread );
+        if( i_ret != VLC_SUCCESS )
+            return -1;
+    }
+
+    /* Always store the mode on the media player variables so that an input
+     * thread created later inherits it (same mechanism as the viewpoint). */
+    var_SetInteger( p_mi, "vr-projection", i_projection );
+    var_SetInteger( p_mi, "vr-stereo", i_stereo );
+    var_SetInteger( p_mi, "vr-eye", i_eye );
+
+    return 0;
+}
