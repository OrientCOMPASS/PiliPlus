diff --git a/player/command.c b/player/command.c
index 96bc06a..bba743e 100644
--- a/player/command.c
+++ b/player/command.c
@@ -2620,6 +2620,63 @@ static int mp_property_vd_imgparams(void *ctx, struct m_property *prop,
     return M_PROPERTY_UNAVAILABLE;
 }
 
+// VR / panoramic source metadata (PiliPlus): read-only strings describing
+// what the demuxer found in the stream's spherical / stereo3d side data.
+// Consumed by the app's "auto (by source metadata)" VR mode:
+//   vr-metadata-projection: none | 360 | 180 | cubemap | other
+//   vr-metadata-layout:     none | mono | sbs | tb | other
+// "cubemap"/"other" mean: recognized as panoramic/3D, but not renderable by
+// the VR renderer (clients must say so explicitly instead of failing
+// silently). Available as soon as the file is loaded (tracks exist), the
+// value does not change during playback.
+static int mp_property_vr_metadata(void *ctx, struct m_property *prop,
+                                   int action, void *arg)
+{
+    MPContext *mpctx = ctx;
+    struct track *track = mpctx->current_track[0][STREAM_VIDEO];
+    struct mp_codec_params *c =
+        track && track->stream ? track->stream->codec : NULL;
+    if (!c)
+        return M_PROPERTY_UNAVAILABLE;
+
+    const char *type = prop->priv;
+    const char *val = "none";
+    if (type[0] == 'l') {
+        switch (c->vr_layout) {
+        case MP_VR_LAYOUT_MONO:  val = "mono";  break;
+        case MP_VR_LAYOUT_SBS:   val = "sbs";   break;
+        case MP_VR_LAYOUT_TB:    val = "tb";    break;
+        case MP_VR_LAYOUT_OTHER: val = "other"; break;
+        }
+    } else {
+        switch (c->vr_projection) {
+        case MP_VR_PROJ_360:     val = "360";     break;
+        case MP_VR_PROJ_180:     val = "180";     break;
+        case MP_VR_PROJ_CUBEMAP: val = "cubemap"; break;
+        case MP_VR_PROJ_OTHER:   val = "other";   break;
+        }
+    }
+    return m_property_strdup_ro(action, arg, val);
+}
+
+// PiliPlus VR: the *effective* view angles (manual offsets + folded gyro
+// bias + head pose) as rendered by vo=gpu's VR renderer, so the client HUD
+// can show the real look direction instead of only the manual component.
+static int mp_property_vr_view_angle(void *ctx, struct m_property *prop,
+                                     int action, void *arg)
+{
+    MPContext *mpctx = ctx;
+    struct vo *vo = mpctx->video_out;
+    if (!vo)
+        return M_PROPERTY_UNAVAILABLE;
+    double angles[2] = {0, 0};
+    if (vo_control(vo, VOCTRL_VR_VIEW_ANGLES, angles) <= 0)
+        return M_PROPERTY_UNAVAILABLE;
+    const char *which = prop->priv;
+    return m_property_double_ro(action, arg,
+                                which[0] == 'y' ? angles[0] : angles[1]);
+}
