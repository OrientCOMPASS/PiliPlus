+        if (only_vr_view_opts_changed(&p->opts_cache_copy, new_opts)) {
+            copy_vr_opts(&p->opts, new_opts);
+            vr_parse_view_string(&p->opts);
+            // This path only runs when VR view fields changed (drag/zoom/
+            // gyro/reset/...): the cached output frame shows the old view.
+            p->output_tex_valid = false;
+        } else {
+            gl_lcms_update_options(p->cms);
+            reinit_from_options(p);
+        }
+        p->opts_cache_copy = *new_opts;
+        vr_sync_opts(p->vr, &p->opts);
     }
 
     if (mp_csp_equalizer_state_changed(p->video_eq))
@@ -4218,6 +4409,7 @@ static void reinit_from_options(struct gl_video *p)
