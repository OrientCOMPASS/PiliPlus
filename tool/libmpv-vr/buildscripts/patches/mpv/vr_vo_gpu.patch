new file mode 100644
index 0000000..9e23fe4
--- /dev/null
+++ b/video/out/gpu/vr_tracker.h
@@ -0,0 +1,50 @@
+/*
+ * VR head tracker for vo=gpu.
+ *
+ * Ported to C from the Cardboard OrientationEKF implementation vendored from
+ * xl_player (https://github.com/xl-player-developers/xl_player):
+ *   xl_head_tracker/{Vector3d,Matrix3x3d,SO3Util,OrientationEKF,HeadTracker}
+ *   xl_video/xl_tracker.c
+ * The math is a line-by-line port (double precision, same constants, same
+ * update order); only the C++ classes were flattened into structs+functions.
+ *
+ * The sensor thread (NDK ASensorManager + ALooper) only exists on Android;
+ * on other platforms vr_tracker_create() returns NULL and head tracking is
+ * unavailable (manual look-around still works).
+ *
+ * This file is part of mpv.
+ *
+ * mpv is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#pragma once
+
+#include <stdbool.h>
+
+struct mp_log;
+
+struct vr_tracker;
+
+// Create the tracker and start the sensor thread. Returns NULL if head
+// tracking is unavailable on this platform or the sensors could not be
+// opened. Thread-safe against vr_tracker_get_view() from the render thread.
+struct vr_tracker *vr_tracker_create(struct mp_log *log);
+
+// True once the first gyroscope sample has been processed - before that the
+// predicted pose is meaningless (EKF still at its initial state).
+bool vr_tracker_has_samples(struct vr_tracker *t);
+
+// Stop the sensor thread and free everything. Safe to call with NULL/*NULL.
+void vr_tracker_destroy(struct vr_tracker *t);
+
+// Reset the EKF state (re-align to gravity on the next accelerometer event).
+void vr_tracker_reset(struct vr_tracker *t);
+
+// Write the predicted head orientation as a column-major 4x4 GL matrix,
+// including the 33 ms look-ahead compensation and the landscape correction
+// matrix (ekf_to_head_tracker) from upstream xl_tracker.c. If the tracker is
+// not running, writes the identity matrix.
+void vr_tracker_get_view(struct vr_tracker *t, float m[16]);
