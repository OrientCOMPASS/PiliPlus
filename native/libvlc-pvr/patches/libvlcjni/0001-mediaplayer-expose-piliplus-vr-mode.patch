+    /**
+     * PiliPlus VR extension: set the VR rendering mode.
+     *
+     * Can be called before playback starts or during playback (takes effect
+     * in place, without restarting playback).
+     *
+     * @param projection 0: auto (source metadata), 1: flat (2D),
+     *                   2: equirectangular 360°, 3: equirectangular 180°
+     * @param stereo     0: auto (source metadata), 1: mono,
+     *                   2: side-by-side, 3: top-bottom
+     * @param eye        0: left eye, 1: right eye
+     * @return true on success.
+     */
+    public boolean setVrMode(int projection, int stereo, int eye) {
+        return nativeSetVrMode(projection, stereo, eye);
+    }
+
+    /**
+     * PiliPlus VR extension: engine VR capability ABI version.
+     *
+     * @return a strictly positive version if the underlying engine carries
+     *         the PiliPlus VR extension, 0 otherwise (e.g. stock libvlc).
+     */
+    public int getVrVersion() {
+        try {
+            return nativeGetVrVersion();
+        } catch (UnsatisfiedLinkError e) {
+            return 0;
+        }
+    }
+
