+/* PiliPlus VR extension: forward the current VR mode to every vout */
+static void VrModeApply( input_thread_t *p_input )
+{
+    input_thread_private_t *priv = input_priv(p_input);
+
+    const int i_projection = var_GetInteger( p_input, "vr-projection" );
+    const int i_stereo = var_GetInteger( p_input, "vr-stereo" );
+    const int i_eye = var_GetInteger( p_input, "vr-eye" );
+
+    vout_thread_t **pp_vout;
+    size_t i_vout;
+    input_resource_HoldVouts( priv->p_resource, &pp_vout, &i_vout );
+
+    for( size_t i = 0; i < i_vout; ++i )
+    {
+        var_SetInteger( pp_vout[i], "vr-projection", i_projection );
+        var_SetInteger( pp_vout[i], "vr-stereo", i_stereo );
+        var_SetInteger( pp_vout[i], "vr-eye", i_eye );
+        vlc_object_release( pp_vout[i] );
+    }
+    free( pp_vout );
+}
