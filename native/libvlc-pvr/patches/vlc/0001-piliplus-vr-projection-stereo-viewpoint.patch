+int vout_display_opengl_SetVrMode(vout_display_opengl_t *vgl, int projection,
+                                  int stereo, int eye)
+{
+    if (vgl->vr_projection == projection
+     && vgl->vr_stereo == stereo
+     && vgl->vr_eye == eye)
+        return VLC_SUCCESS;
+
+    vgl->vr_projection = projection;
+    vgl->vr_stereo = stereo;
+    vgl->vr_eye = eye;
+
+    /* Force a geometry rebuild on the next displayed picture */
+    vgl->last_source.i_x_offset = (unsigned) -1;
+
+    const video_projection_mode_t eff_proj = EffectiveProjection(vgl);
+    if (eff_proj != PROJECTION_MODE_RECTANGULAR)
+    {
+        if (!vgl->vr_vp_init)
+        {
+            vlc_viewpoint_init(&vgl->cur_vp);
+            vgl->vr_vp_init = true;
+        }
+        /* Re-apply the current viewpoint so that clamping/matrixes match the
+         * new projection mode. */
+        return vout_display_opengl_SetViewpoint(vgl, &vgl->cur_vp);
+    }
+
+    vgl->vr_vp_init = false;
+    getViewpointMatrixes(vgl, eff_proj, vgl->prgm);
+    return VLC_SUCCESS;
+}
