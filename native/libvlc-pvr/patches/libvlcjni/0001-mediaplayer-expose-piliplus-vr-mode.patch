+/* PiliPlus VR extension */
+jboolean
+Java_org_videolan_libvlc_MediaPlayer_nativeSetVrMode(JNIEnv *env,
+                                                     jobject thiz,
+                                                     jint projection,
+                                                     jint stereo,
+                                                     jint eye)
+{
+    vlcjni_object *p_obj = VLCJniObject_getInstance(env, thiz);
+    if (!p_obj)
+        return false;
+
+    return libvlc_media_player_set_vr_mode(p_obj->u.p_mp, projection, stereo,
+                                           eye) == 0 ? true : false;
+}
+
+jint
+Java_org_videolan_libvlc_MediaPlayer_nativeGetVrVersion(JNIEnv *env,
+                                                        jobject thiz)
+{
+    (void) env; (void) thiz;
+    return libvlc_pili_vr_version();
+}
